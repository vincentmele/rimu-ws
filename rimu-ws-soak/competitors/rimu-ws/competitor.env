# What competitor.sh needs to build and run this server.
NAME=rimu-ws
KIND=library            # library | framework | hand-rolled
SOURCE=local            # local | httparena
HTTPARENA_DIR=          # frameworks/<dir> when SOURCE=httparena
URL_PATH=/              # the WebSocket path the server answers on
IO_URING=1              # 1 if the server claims io_uring: the run passes --expect-io-uring
BUILD_CONTEXT=repo      # repo (rimu-ws root) | self (this directory) | httparena (patched entry)
